+        "raining": { "type": "boolean" }, "thundering": { "type": "boolean" },
+        "playersOnline": { "type": "integer", "minimum": 0 }, "hostileCount": { "type": "integer", "minimum": 0 },
+        "threat": { "enum": ["none", "low", "high"] },
+        "health": { "type": "number" }, "food": { "type": "number" },
+        "dimension": { "type": "string" }, "source": { "type": "string" } } },
+    "StatsSnapshot": { "type": "object", "required": ["botId", "ts", "windowMs", "skills"], "additionalProperties": false,
+      "properties": {
+        "botId": { "type": "string" }, "ts": { "type": "integer" }, "windowMs": { "type": "integer", "minimum": 0 },
+        "context": { "$ref": "#/definitions/StatsContext" },
+        "skills": { "type": "object", "additionalProperties": false,
+          "patternProperties": { "^[a-z][a-z0-9_.]{0,63}$": { "type": "object", "required": ["n", "ok", "fail", "avgMs"], "additionalProperties": false,
+            "properties": { "n": { "type": "integer", "minimum": 0 }, "ok": { "type": "integer", "minimum": 0 }, "fail": { "type": "integer", "minimum": 0 },
+              "avgMs": { "type": "number", "minimum": 0 } } } } } } },
+    "BatchScore": { "type": "object", "required": ["batchId", "ts", "version", "total", "components", "skipped"], "additionalProperties": false,
+      "properties": {
+        "batchId": { "type": "string", "minLength": 1 }, "ts": { "type": "integer" }, "version": { "type": "string", "minLength": 1 },
+        "total": { "type": "number", "minimum": 0, "maximum": 100 },
+        "components": { "type": "object", "additionalProperties": false,
+          "properties": { "completion": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }, "safety": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
