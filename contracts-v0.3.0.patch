--- a/contracts/contracts.schema.json
+++ b/contracts/contracts.schema.json
@@ -1,7 +1,7 @@
 {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "$id": "arcadia/contracts",
-  "title": "Arcadia contracts v0.1.0",
+  "title": "Arcadia contracts v0.3.0",
   "definitions": {
     "Vec3": { "type": "object", "required": ["x", "y", "z"], "additionalProperties": false,
       "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } } },
@@ -62,7 +62,43 @@
         "chat": { "type": "object", "additionalProperties": false,
           "properties": { "style": { "type": "string" }, "language": { "type": "string" }, "verbosity": { "type": "number", "minimum": 0, "maximum": 1 } } },
         "limits": { "type": "object", "additionalProperties": false,
-          "properties": { "fleeBelowHealth": { "type": "number", "minimum": 0 }, "maxLlmCallsPerMin": { "type": "integer", "minimum": 0 } } } } },
+          "properties": { "fleeBelowHealth": { "type": "number", "minimum": 0 }, "maxLlmCallsPerMin": { "type": "integer", "minimum": 0 } } },
+        "needs": { "type": "object", "additionalProperties": false,
+          "properties": { "energy": { "type": "number", "minimum": 0, "maximum": 1 }, "safety": { "type": "number", "minimum": 0, "maximum": 1 },
+            "boredom": { "type": "number", "minimum": 0, "maximum": 1 } } },
+        "affection": { "type": "number", "minimum": 0, "maximum": 1 },
+        "xp": { "type": "integer", "minimum": 0 },
+        "level": { "type": "integer", "minimum": 1 } } },
+    "StatsContext": { "type": "object", "additionalProperties": false,
+      "properties": {
