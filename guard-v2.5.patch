+  ok(o.ok && o.data.kills === 1 && o.data.hits >= 2, 'guard.post: zombie dalam jangkauan serang -> diserang sampai mati (melee)')
+  b = mk({}); b.mob(1, 'zombie', 30.5, 0.5)
