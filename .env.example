# Salin menjadi .env di root proyek, kemudian edit sendiri. Jangan kirim key ke chat.
# Ollama Cloud memakai adapter OpenAI-compatible; key tetap milik Ollama.
ARCADIA_LLM_PROVIDER=openai
ARCADIA_LLM_URL=https://ollama.com/v1
ARCADIA_LLM_MODEL=GANTI_DENGAN_NAMA_MODEL_OLLAMA
ARCADIA_LLM_KEY=
ARCADIA_LLM_RPM=3
ARCADIA_DIRECTOR_AUTO=

# Agent: mode izin awal (selanjutnya tersimpan per bot melalui slider UI).
ARCADIA_AGENT_PERMISSION=semi
ARCADIA_MODE=production
ARCADIA_DEBUG_UNSAFE_SANDBOX=false
# Command production membutuhkan Docker dan image ini sudah di-pull oleh pemilik.
ARCADIA_SANDBOX_IMAGE=node:22-alpine

# Untuk Ollama lokal: URL http://127.0.0.1:11434/v1, model dari `ollama list`, key kosong.
